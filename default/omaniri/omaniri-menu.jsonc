{
  // Omaniri menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here. See docs/menu.md.
  // Optional fields:
  //   aliases        alternate `omaniri menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"omaniri-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"omaniri-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"omaniri-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! omaniri-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"omaniri-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"omaniri-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"omaniri-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"omaniri-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"omaniri-menu-keybindings"},
  "learn.omaniri": {"icon":"","label":"Omaniri","action":"omaniri-launch-webapp 'https://omarchy.org/manual/'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"omaniri-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"omaniri-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"omaniri-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"omaniri-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"omaniri-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"omaniri-menu-herdr-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Community","action":"omaniri-launch-discord-community"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"omaniri-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"omaniri-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"omaniri-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"omaniri-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"omaniri-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"omaniri-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"omaniri-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"omaniri-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"omaniri-hw-webcam","action":"omaniri-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"omaniri-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"omaniri-hw-laptop","action":"omaniri-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"omaniri-hw-laptop","action":"omaniri-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"omaniri-hw-hybrid-gpu","action":"omaniri-launch-floating-terminal-with-presentation omaniri-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"omaniri-hw-touchpad","action":"omaniri-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"omaniri-hw-dell-xps-haptic-touchpad && omaniri-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"omaniri-hw-dell-xps-haptic-touchpad && omaniri-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"omaniri-hw-dell-xps-haptic-touchpad && omaniri-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"omaniri-hw-touchscreen","action":"omaniri-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"omaniri-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"omaniri-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"omaniri-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"omaniri-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"omaniri-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"omaniri-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"omaniri-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"omaniri-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"omaniri-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"omaniri-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"omaniri-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"omaniri-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"omaniri-hw-laptop","action":"omaniri-shell omaniri.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"omaniri-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"omaniri-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"omaniri-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"omaniri-shell shell summon omaniri.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"omaniri-shell shell summon omaniri.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(omaniri-theme-switcher); [[ -n $theme ]] && omaniri-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(omaniri-theme-bg-switcher); [[ -n $background ]] && omaniri-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(omaniri-plymouth-switcher); if [[ $unlock == default ]]; then omaniri-launch-floating-terminal-with-presentation omaniri-plymouth-reset; elif [[ -n $unlock ]]; then omaniri-launch-floating-terminal-with-presentation \"omaniri-plymouth-set-by-theme '$unlock'\"; fi"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"omaniri-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"omaniri-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"omaniri-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"omaniri-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"omaniri-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"omaniri-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"omaniri-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"omaniri-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"omaniri-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"omaniri-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"omaniri-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"omaniri-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"omaniri-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"omaniri-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"omaniri-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(omaniri-dns)\" == \"DHCP\" ]]","action":"omaniri-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(omaniri-dns)\" == \"Cloudflare\" ]]","action":"omaniri-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(omaniri-dns)\" == \"Google\" ]]","action":"omaniri-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(omaniri-dns)\" == \"Custom\" ]]","action":"omaniri-launch-floating-terminal-with-presentation 'omaniri-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(omaniri-network-status) == wifi* ]]","action":"omaniri-shell shell summon omaniri.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(omaniri-default-agent)\" == \"claude\" ]]","action":"omaniri-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"omaniri","label":"Codex","checked":"[[ \"$(omaniri-default-agent)\" == \"codex\" ]]","action":"omaniri-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(omaniri-default-agent)\" == \"copilot\" ]]","action":"omaniri-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(omaniri-default-agent)\" == \"crush\" ]]","action":"omaniri-default-agent crush"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","checked":"[[ \"$(omaniri-default-agent)\" == \"gemini\" ]]","action":"omaniri-default-agent gemini"},
  "setup.default.agent.grok": {"icon":"","iconFont":"omaniri","label":"Grok","checked":"[[ \"$(omaniri-default-agent)\" == \"grok\" ]]","action":"omaniri-default-agent grok"},
  "setup.default.agent.omp": {"icon":"","iconFont":"omaniri","label":"omp","checked":"[[ \"$(omaniri-default-agent)\" == \"omp\" ]]","action":"omaniri-default-agent omp"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"omaniri","label":"OpenCode","checked":"[[ \"$(omaniri-default-agent)\" == \"opencode\" ]]","action":"omaniri-default-agent opencode"},
  "setup.default.agent.pi": {"icon":"","iconFont":"omaniri","label":"Pi","checked":"[[ \"$(omaniri-default-agent)\" == \"pi\" ]]","action":"omaniri-default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","checked":"[[ \"$(omaniri-default-browser)\" == \"chromium\" ]]","action":"omaniri-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","checked":"[[ \"$(omaniri-default-browser)\" == \"chrome\" ]]","action":"omaniri-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","checked":"[[ \"$(omaniri-default-browser)\" == \"brave\" ]]","action":"omaniri-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","checked":"[[ \"$(omaniri-default-browser)\" == \"brave-origin\" ]]","action":"omaniri-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","checked":"[[ \"$(omaniri-default-browser)\" == \"edge\" ]]","action":"omaniri-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","checked":"[[ \"$(omaniri-default-browser)\" == \"firefox\" ]]","action":"omaniri-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","checked":"[[ \"$(omaniri-default-browser)\" == \"zen\" ]]","action":"omaniri-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","checked":"[[ \"$(omaniri-default-terminal)\" == \"alacritty\" ]]","action":"omaniri-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","checked":"[[ \"$(omaniri-default-terminal)\" == \"foot\" ]]","action":"omaniri-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","checked":"[[ \"$(omaniri-default-terminal)\" == \"ghostty\" ]]","action":"omaniri-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","checked":"[[ \"$(omaniri-default-terminal)\" == \"kitty\" ]]","action":"omaniri-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","checked":"[[ \"$(omaniri-default-editor)\" == \"nvim\" ]]","action":"omaniri-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","checked":"[[ \"$(omaniri-default-editor)\" == \"code\" ]]","action":"omaniri-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","label":"Cursor","checked":"[[ \"$(omaniri-default-editor)\" == \"cursor\" ]]","action":"omaniri-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","checked":"[[ \"$(omaniri-default-editor)\" == \"zeditor\" ]]","action":"omaniri-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","checked":"[[ \"$(omaniri-default-editor)\" == \"sublime_text\" ]]","action":"omaniri-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","checked":"[[ \"$(omaniri-default-editor)\" == \"helix\" ]]","action":"omaniri-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","checked":"[[ \"$(omaniri-default-editor)\" == \"vim\" ]]","action":"omaniri-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","checked":"[[ \"$(omaniri-default-editor)\" == \"emacs\" ]]","action":"omaniri-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"omaniri-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"omaniri-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"omaniri-launch-floating-terminal-with-presentation 'omaniri-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"omaniri-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/omaniri/plugins/*/manifest.json\"","action":"omaniri-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"omaniri-hw-fingerprint","action":"omaniri-launch-floating-terminal-with-presentation omaniri-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"omaniri-launch-floating-terminal-with-presentation omaniri-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"omaniri-launch-floating-terminal-with-presentation omaniri-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"omaniri-launch-floating-terminal-with-presentation omaniri-sudo-passwordless"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"omaniri-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"omaniri-launch-config-editor ~/.config/hypr/hyprsunset.conf && omaniri-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"omaniri-launch-config-editor ~/.XCompose && omaniri-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"omaniri-launch-floating-terminal-with-presentation omaniri-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"omaniri-launch-floating-terminal-with-presentation omaniri-system-factory-reset"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.omaniri.terminal omaniri-pkg-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.omaniri.terminal omaniri-pkg-aur-install"},
  "install.webapp": {"icon":"","label":"Web App","action":"omaniri-launch-floating-terminal-with-presentation omaniri-webapp-install"},
  "install.tui": {"icon":"","label":"TUI","action":"omaniri-launch-floating-terminal-with-presentation omaniri-tui-install"},
  "install.style": {"icon":"","label":"Style"},
  "install.style.theme": {"icon":"󰸌","label":"Theme","action":"omaniri-launch-floating-terminal-with-presentation omaniri-theme-install"},
  "install.style.background": {"icon":"","label":"Background","action":"omaniri-theme-bg-install"},
  "install.style.font": {"icon":"","label":"Font"},
  "install.style.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"omaniri-install-font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'"},
  "install.style.font.meslo": {"icon":"","label":"Meslo LG Mono","action":"omaniri-install-font 'Meslo LG Mono' ttf-meslo-nerd 'MesloLGL Nerd Font'"},
  "install.style.font.fira": {"icon":"","label":"Fira Code","action":"omaniri-install-font 'Fira Code' ttf-firacode-nerd 'FiraCode Nerd Font'"},
  "install.style.font.victor": {"icon":"","label":"Victor Code","action":"omaniri-install-font 'Victor Code' ttf-victor-mono-nerd 'VictorMono Nerd Font'"},
  "install.style.font.bitstream": {"icon":"","label":"Bitstream Vera Mono","action":"omaniri-install-font 'Bitstream Vera Code' ttf-bitstream-vera-mono-nerd 'BitstromWera Nerd Font'"},
  "install.style.font.iosevka": {"icon":"","label":"Iosevka","action":"omaniri-install-font Iosevka ttf-iosevka-nerd 'Iosevka Nerd Font Mono'"},
  "install.service": {"icon":"","label":"Service"},
  "install.development": {"icon":"󰵮","label":"Development"},
  "install.editor": {"icon":"","label":"Editor"},
  "install.terminal": {"icon":"","label":"Terminal"},
  "install.browser": {"icon":"","label":"Browser"},
  "install.ai": {"icon":"󱚤","label":"AI"},
  "install.gaming": {"icon":"","label":"Gaming"},
  "install.windows": {"icon":"󰍲","label":"Windows","disabled":"[[ -f $HOME/.local/share/applications/windows-vm.desktop ]]","action":"omaniri-launch-floating-terminal-with-presentation 'omaniri-windows-vm install'"},
  "install.preinstalls": {"icon":"󰏓","label":"Preinstalls","disabled":"[[ ! -f $HOME/.local/state/omaniri/preinstalls-removed ]]","action":"omaniri-launch-floating-terminal-with-presentation omaniri-install-preinstalls"},
