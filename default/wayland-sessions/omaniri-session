#!/bin/bash

# Omaniri session launcher. Replaces uwsm's session handling: it sources the
# shared env bootstrap, applies session defaults, publishes the environment to
# the systemd user manager, then hands off to niri's own session wrapper.
# niri-session runs niri as a systemd service bound to graphical-session.target,
# so user units and portals get the same integration uwsm used to provide.

# Single source of truth for OMANIRI_PATH + PATH adjustments — the same file
# login shells source. uwsm used to do this via /usr/share/uwsm/env.d.
[ -r "${OMANIRI_PATH:-/usr/share/omaniri}/default/bash/env-bootstrap" ] &&
  . "${OMANIRI_PATH:-/usr/share/omaniri}/default/bash/env-bootstrap"

# Session defaults. Users can override these in ~/.config/omaniri/session-defaults.
if [ -f "${OMANIRI_PATH%/}/default/session/default" ]; then
  . "${OMANIRI_PATH%/}/default/session/default"
else
  export TERMINAL=xdg-terminal-exec
  export EDITOR="omaniri-launch-editor --inline"
fi

# Optional user overrides kept for compatibility with older installs.
[ -f "$HOME/.config/omaniri/session-defaults" ] && . "$HOME/.config/omaniri/session-defaults"
# Legacy location from the uwsm era — still honored so existing users' tweaks
# survive the switch; consider moving to ~/.config/omaniri/session-defaults.
[ -f "$HOME/.config/uwsm/default" ] && . "$HOME/.config/uwsm/default"

# Activate mise if present on the system
omaniri-cmd-present mise && eval "$(mise activate bash --shims)"

# Publish the session environment to the systemd user manager, so every unit
# started under graphical-session.target sees the variables this session was
# started with (the other half of what uwsm's env.d used to do).
systemctl --user import-environment OMANIRI_PATH PATH TERMINAL EDITOR 2>/dev/null || true

exec niri-session
