# Adapted from upstream omarchy-pkgs omarchy-settings.install for the Omaniri
# tree. The etc-overrides mechanism is unchanged: files the package can't own
# outright (upstream Arch packages own the live paths) are staged at
# /usr/share/omaniri/etc-overrides/ and copied into place by this scriptlet.
# Documented limitation: the copy is unconditional, so each upgrade clobbers
# user edits to these four files.

post_install() {
  local overrides=/usr/share/omaniri/etc-overrides
  [[ -d $overrides ]] || return 0

  install -Dm644 "$overrides/security-faillock.conf" /etc/security/faillock.conf
  install -Dm644 "$overrides/nsswitch.conf" /etc/nsswitch.conf
  install -Dm644 "$overrides/cups-cups-browsed.conf" /etc/cups/cups-browsed.conf
  install -Dm644 "$overrides/plymouth-plymouthd.conf" /etc/plymouth/plymouthd.conf
}

post_upgrade() {
  post_install "$@"
}
