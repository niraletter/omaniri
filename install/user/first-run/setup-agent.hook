#!/bin/bash

set -e

# Omaniri ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(omaniri-default-agent) ]] && omaniri-done ensure agent-setup-invitation; then
  omaniri-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Omaniri." \
    --exec "omaniri menu summon setup.default.agent"
fi
