#!/bin/bash

# omaniri:summary=Print the installed Omaniri version

omaniri_path=${OMANIRI_PATH:-/usr/share/omaniri}
omaniri_path=${omaniri_path%/}

if [[ $omaniri_path != "/usr/share/omaniri" ]]; then
  hash=$(git -C "$omaniri_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The edge channel installs omaniri-dev instead of omaniri, so check both.
for package in omaniri-dev omaniri; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || exit 1

echo "$version"
