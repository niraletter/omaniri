#!/bin/bash

# omaniri:summary=Update the active Omaniri dev checkout

set -euo pipefail

[[ $OMANIRI_PATH != "/usr/share/omaniri" ]] || exit 0

if ! git -C "$OMANIRI_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMANIRI_PATH is not a git checkout: $OMANIRI_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMANIRI_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omaniri dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Omaniri dev checkout\e[0m"
git -C "$OMANIRI_PATH" pull --ff-only
