#!/bin/bash

# omaniri:summary=Print the directory holding a theme, preferring a user-installed copy
# omaniri:args=<theme-name>
# omaniri:examples=omaniri theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: omaniri-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/omaniri/themes/$theme ]]; then
  echo "$HOME/.config/omaniri/themes/$theme"
else
  echo "$OMANIRI_PATH/themes/$theme"
fi
