#!/bin/bash

# omaniri:summary=Show which theme is styling the Plymouth boot screen
# omaniri:examples=omaniri plymouth current

# omaniri-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/omaniri/logo.png

if cmp -s "$OMANIRI_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

omaniri-plymouth-list | while read -r name; do
  if cmp -s "$(omaniri-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
