#!/bin/bash

# omaniri:summary=Save or restore the focused Niri window's column width
# omaniri:args=<save|restore>
# Ported from omaniri-hyprland-window-width.
#
# SIMPLIFIED PORT: Hyprland's version has to binary-search resize deltas
# because `resizeactive` is relative-only and Hyprland doesn't reliably
# report back the width it actually landed on for oddly-constrained windows.
# Niri's `set-column-width` IPC action takes an absolute pixel value directly
# (`niri msg action set-column-width "<px>"`), so the probing/binary-search
# dance is unnecessary and has been dropped entirely -- this is a real
# simplification, not a corner cut.

set -euo pipefail

STATE_DIR="$HOME/.local/state/omaniri/windows-niri"

usage() {
  echo "Usage: omaniri-niri-window-width save|restore" >&2
  exit 1
}

focused_window() {
  niri msg -j focused-window 2>/dev/null
}

window_key() {
  jq -r '[.app_id, .title] | map(select(. != null and . != "")) | first // empty' <<<"$1"
}

workspace_key() {
  jq -r '.workspace_id // empty' <<<"$1"
}

state_file_for() {
  local key="$1" workspace="$2" filename="workspace-${workspace}-${key}"
  filename="${filename//\//_}"
  filename="${filename//$'\n'/_}"
  printf '%s/%s.width' "$STATE_DIR" "$filename"
}

action=${1:-}
[[ $action == "save" || $action == "restore" ]] || usage

active=$(focused_window)
[[ -n $active && $active != "null" ]] || exit 1

key=$(window_key "$active")
[[ -n $key ]] || exit 1
workspace=$(workspace_key "$active")
[[ -n $workspace ]] || exit 1

state_file=$(state_file_for "$key" "$workspace")

case "$action" in
save)
  width=$(jq -er '.window_size[0]' <<<"$active" 2>/dev/null || jq -er '.width' <<<"$active")
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.width.XXXXXX")
  printf '%s\n' "$width" >"$tmp"
  mv "$tmp" "$state_file"
  omaniri-notification-send -g  "Saved width for $key on workspace $workspace"
  ;;
restore)
  if [[ ! -f $state_file ]]; then
    omaniri-notification-send -g  "No saved width found for $key on workspace $workspace"
    exit 1
  fi
  width=$(<"$state_file")
  [[ $width =~ ^[0-9]+$ ]] || exit 1
  niri msg action set-column-width "${width}" >/dev/null 2>&1
  ;;
esac
