#!/bin/bash

# omaniri:summary=Install a Nerd Font package and switch the system to it
# omaniri:args=<display-name> <package> <family>
# omaniri:examples=omaniri install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: omaniri-install-font <display-name> <package> <family>" >&2
  exit 1
fi

exec omaniri-launch-floating-terminal-with-presentation \
  "echo 'Installing ${name}...'; omaniri-pkg-add ${package} && sleep 2 && omaniri-font-set '${family}'"
