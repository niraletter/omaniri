#!/bin/bash

# omaniri:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# omaniri:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
omaniri-pkg-add heroic-games-launcher-bin
omaniri-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
