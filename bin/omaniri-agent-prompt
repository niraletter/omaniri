#!/bin/bash

# omaniri:summary=Launch the default coding agent with a prompt
# omaniri:args=[--inline] <prompt...>
# omaniri:examples=omaniri agent prompt "Review this project"

# Prompts live here rather than on `omaniri agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: omaniri agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec omaniri-agent "${inline[@]}" --prompt "$*"
