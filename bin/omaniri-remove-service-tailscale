#!/bin/bash

# omaniri:summary=Remove Tailscale and its bar plugin.
# omaniri:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now omaniri-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
omaniri-plugin-disable omaniri.tailscale
omaniri-webapp-remove "Tailscale" 2>/dev/null || true
omaniri-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
