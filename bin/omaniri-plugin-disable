#!/bin/bash

# omaniri:summary=Disable a shell plugin
# omaniri:group=plugin
# omaniri:args=<id>

set -euo pipefail

fail() {
  echo "omaniri-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: omaniri plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(omaniri-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: omaniri-shell shell rescanPlugins"

echo "Disabled $id"
