#!/bin/bash

# omaniri:summary=Send the low battery warning notification and run battery-low hooks.
# omaniri:args=<percentage>
# omaniri:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: omaniri-battery-low <percentage>" >&2
  exit 1
fi

level=$1

omaniri-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
omaniri-hook battery-low "$level"
