#!/bin/bash

# omaniri:summary=Set the Omaniri package channel.
# omaniri:args=<stable|rc|edge|dev>
# omaniri:requires-sudo=true

set -euo pipefail

usage() { echo "Usage: omaniri-channel-set [stable|rc|edge|dev]"; }
fail() { echo "Error: $*" >&2; exit 1; }

confirm_dev() {
  cat <<'WARNING'

The dev channel links Omaniri directly to a checkout of the source in ~/omaniri.
It's exclusively intended for developers working on Omaniri itself.

WARNING

  gum confirm --default=false "Switch to dev channel?"
}

validate_dev_checkout() {
  local checkout="$1"

  if [[ -e $checkout && ! -d $checkout/.git ]]; then
    fail "$checkout already exists and is not a git checkout."
  fi

  if [[ -d $checkout/.git && ( ! -d $checkout/bin || ! -d $checkout/default || ! -d $checkout/shell ) ]]; then
    fail "$checkout is a git checkout, but it does not look like Omaniri."
  fi
}

link_dev_checkout() {
  local checkout="$1"
  [[ -d $checkout/.git ]] || git clone https://github.com/niraletter/omaniri.git "$checkout"

  omaniri-dev-link "$checkout" --no-reboot
}

(( $# > 0 )) || { usage; exit 1; }

dev_checkout=""
channel="$1"
leaving_dev=0

case "$channel" in
  stable)
    pacman_channel=stable
    packages=(omaniri omaniri-settings)
    ;;
  rc)
    pacman_channel=rc
    packages=(omaniri omaniri-settings)
    ;;
  edge)
    pacman_channel=edge
    packages=(omaniri-dev omaniri-settings-dev)
    ;;
  dev)
    confirm_dev || { echo "Cancelled."; exit 0; }
    dev_checkout="$HOME/omaniri"
    validate_dev_checkout "$dev_checkout"
    pacman_channel=edge
    packages=(omaniri-dev omaniri-settings-dev)
    ;;
  *)
    echo "Unknown channel: $channel" >&2
    usage >&2
    exit 1
    ;;
esac

if [[ -z $dev_checkout && $OMANIRI_PATH != "/usr/share/omaniri" ]]; then
  leaving_dev=1
fi

if [[ -n $dev_checkout ]]; then
  link_dev_checkout "$dev_checkout"
  export OMANIRI_PATH="$dev_checkout"
  export PATH="$OMANIRI_PATH/bin:$PATH"
  omaniri-state set reboot-required
fi

omaniri-refresh-pacman "$pacman_channel"
# --ask 4 accepts omaniri <-> omaniri-dev replacement prompts without file overwrites.
sudo env OMANIRI_UPDATE_PACMAN=1 pacman -S --needed --noconfirm --ask 4 "${packages[@]}"

if [[ -z $dev_checkout ]]; then
  omaniri-dev-unlink --no-reboot
  export OMANIRI_PATH=/usr/share/omaniri

  if (( leaving_dev )); then
    omaniri-state set reboot-required
  fi
fi

omaniri-update -y
