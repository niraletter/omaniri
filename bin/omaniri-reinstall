#!/bin/bash

# omaniri:summary=Reinstall Omaniri packages and reset default configs
# omaniri:requires-sudo=true

set -e

echo -e "This will reinstall all default Omaniri packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  omaniri-reinstall-pkgs
  omaniri-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && omaniri-system-reboot
fi
