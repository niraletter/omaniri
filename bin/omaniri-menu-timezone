#!/bin/bash

# omaniri:summary=Select and set the system timezone
# omaniri:group=menu
# omaniri:name=timezone

set -e

timezone=$(timedatectl list-timezones | omaniri-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
omaniri-shell -q omaniri.clock refresh
omaniri-notification-send "Timezone is now set to $timezone"
