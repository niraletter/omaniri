#!/bin/bash

# omaniri:summary=Install Emacs with Omaniri theme and font integration via the omaniri-emacs AUR package

echo "Installing Emacs..."
omaniri-pkg-aur-add omaniri-emacs && omaniri-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid gtk-launch emacsclient >/dev/null 2>&1 &
