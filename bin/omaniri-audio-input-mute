#!/bin/bash

# omaniri:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  omaniri-brightness-keyboard-mute on
  omaniri-osd -i microphone-muted -m "Microphone muted"
else
  omaniri-brightness-keyboard-mute off
  omaniri-osd -i microphone -m "Microphone on"
fi
