#!/bin/bash

# omaniri:summary=Launch a TUI command in the default terminal with Omaniri styling
# omaniri:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.omaniri.$(basename $1)"
fi

exec setsid xdg-terminal-exec --app-id=$APP_ID -e "$1" "${@:2}"
