#!/bin/bash

# omaniri:summary=Print the active Omaniri package channel

set -euo pipefail

# Dev is a linked source checkout: OMANIRI_PATH points somewhere other than
# the package-backed install at /usr/share/omaniri. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $OMANIRI_PATH != "/usr/share/omaniri" ]]; then
  echo dev
  exit 0
fi

# omaniri-dev / omaniri-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. omaniri / omaniri-settings come
# from either the stable or rc mirror, distinguished by omaniri-version-channel
# (which reports the mirror as its first token).
if pacman -Q omaniri-dev omaniri-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q omaniri omaniri-settings >/dev/null 2>&1; then
  channel=$(omaniri-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
