#!/bin/bash

# omaniri:summary=Launch a TUI or focus an existing terminal window for it
# omaniri:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.omaniri.$(basename "$1")"
fi

LAUNCH_COMMAND="omaniri-launch-tui $@"

exec omaniri-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
