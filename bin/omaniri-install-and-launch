#!/bin/bash

# omaniri:summary=Install a packaged app and launch it once it finishes
# omaniri:args=<display-name> <packages> <desktop-id>
# omaniri:examples=omaniri install and launch Cursor cursor-bin cursor

name="${1-}"
packages="${2-}"
desktop_id="${3-}"

if [[ -z $name || -z $packages || -z $desktop_id ]]; then
  echo "Usage: omaniri-install-and-launch <display-name> <packages> <desktop-id>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v desktop_id_arg '%q' "$desktop_id"

# The subshell keeps & from backgrounding the package installation too.
exec omaniri-launch-floating-terminal-with-presentation \
  "echo ${install_message}; omaniri-pkg-add ${packages} && (setsid gtk-launch ${desktop_id_arg} >/dev/null 2>&1 &)"
