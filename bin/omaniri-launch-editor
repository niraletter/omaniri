#!/bin/bash

# omaniri:summary=Launch the default editor selected via Omaniri defaults.
# omaniri:args=[--inline] <path>

default_editor="$HOME/.local/state/omaniri/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

omaniri-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec omaniri-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid "$editor" "$@"
  ;;
esac
