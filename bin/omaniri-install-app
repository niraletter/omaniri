#!/bin/bash

# omaniri:summary=Install a packaged app, surfacing the install in a floating terminal
# omaniri:args=<display-name> <packages>
# omaniri:examples=omaniri install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: omaniri-install-app <display-name> <packages>" >&2
  exit 1
fi

exec omaniri-launch-floating-terminal-with-presentation "echo 'Installing ${name}...'; omaniri-pkg-add ${packages}"
