#!/bin/bash

# omaniri:summary=Remove the GeForce NOW Flatpak app and its data.
# omaniri:group=remove
# omaniri:name=gaming geforce-now

set -e

if omaniri-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
