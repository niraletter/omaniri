{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omaniri.clock",
    "layout": {
      "left": [
        {
          "id": "omaniri.menu"
        },
        {
          "id": "omaniri.workspaces"
        }
      ],
      "center": [
        {
          "id": "omaniri.indicators"
        },
        {
          "id": "omaniri.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omaniri.keyboard-layout"
        },
        {
          "id": "omaniri.weather"
        },
        {
          "id": "omaniri.system-update"
        }
      ],
      "right": [
        {
          "id": "omaniri.tray"
        },
        {
          "id": "omaniri.agents"
        },
        {
          "id": "omaniri.bluetooth"
        },
        {
          "id": "omaniri.network"
        },
        {
          "id": "omaniri.audio"
        },
        {
          "id": "omaniri.monitor"
        },
        {
          "id": "omaniri.power"
        }
      ]
    }
  },
  "plugins": []
}
